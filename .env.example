# openplate-gateway configuration.
#
# Every value below is a PLACEHOLDER. Nothing real belongs in this file — it is
# committed to a public repository.
#
# THIS FILE IS READ BY `docker compose` ONLY. Compose loads it through
# `env_file: ../.env` in docker/compose.yml. Nothing in the service reads it:
# there is no dotenv dependency and there is not going to be one. `pnpm dev`
# and `pnpm start` see only what your shell exported, so run them like this:
#
#   set -a && . ./.env && set +a && pnpm dev

# ── The upstream provider ──────────────────────────────────────────────────
# Where the gateway forwards requests. Any OpenAI-compatible endpoint works:
#   OpenRouter                https://openrouter.ai/api/v1
#   Mistral                   https://api.mistral.ai/v1
#   your own openplate-inference   http://inference:8300/v1
UPSTREAM_BASE_URL=https://openrouter.ai/api/v1

# The PAYER's real provider key. This is the one secret in the system, and it is
# the only place it exists — members never see it.
#
# Give this key a hard spend cap at the provider as well. The gateway's own
# per-member quotas are the first line of defence, not the last one.
UPSTREAM_API_KEY=replace-me

# ── State ──────────────────────────────────────────────────────────────────
# Every path below is resolved against the process working directory, so the
# values here are `pnpm start` paths meaning "the repository root". In Docker
# they are different, and the compose files under docker/ set them explicitly —
# do not expect these lines to apply there.
#
# ALL THREE STORE FILES MUST BE ON DURABLE STORAGE, for two different reasons:
# lose the quota counters and every member gets a fresh allowance; lose the
# member store and every member is revoked.

# The member registry: who may spend the key, how much, and whether they still
# may. Written at runtime by the admin API, by an invite redemption, and by
# `pnpm mint-token`. Holds SHA-256 digests of member tokens, never the tokens.
MEMBER_STORE_FILE=./member-store.json

# Outstanding and spent invitations. Digests only, same as above.
INVITE_STORE_FILE=./invite-store.json

# The daily quota counters.
QUOTA_STORE_FILE=./quota-store.json

# The LEGACY hand-edited registry from before ADR-0002. It is read once, folded
# into the member store, backed up as members.json.bak beside the store, and
# then ignored forever. An installation that never had one can ignore this line:
# an absent file is normal, and the gateway starts without it.
MEMBERS_FILE=./members.json

# ── The admin API ──────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
#
# LEAVING THIS UNSET DISABLES THE ADMIN API COMPLETELY. `/admin` then answers
# "no such endpoint" to everybody, exactly as any other unknown address does —
# a gateway that never wanted an admin API does not advertise that it has one.
# You can still add people with `pnpm mint-token`.
#
# Minimum 24 characters. This one token can read the roster and mint members, so
# it must be generated, not chosen.
# GATEWAY_ADMIN_TOKEN=

# ── This gateway's identity ────────────────────────────────────────────────
# Shown to members by /v1/gateway/info, so they can tell two instances apart.
# GATEWAY_NAME=openplate gateway

# Language of the admin console and the invite email. `en` or `de`. Default: en.
# One choice for the whole gateway: the invite email has no browser to ask, and
# a console in one language mailing in another is worse than both in English.
# API error messages stay English on purpose — clients branch on the status
# code, not on the words. See src/errors.ts.
# GATEWAY_LANGUAGE=de

# The model id members should ask for. Optional — leave unset if you have not
# pinned one, and members choose.
# GATEWAY_ADVERTISED_MODEL=

# ── Invite links ───────────────────────────────────────────────────────────
# Both are needed to build an invite link. Without them the admin API still
# issues invites; it just returns the raw token instead of a link.
#
# GATEWAY_PUBLIC_URL is how OTHER PEOPLE reach this gateway — not `localhost`,
# which to them means their own machine.
# Must be https: on any host but localhost/127.0.0.1 — openplate refuses an
# invite link whose gateway address is plain http on a LAN hostname.
# GATEWAY_PUBLIC_URL=https://gateway.lan:3602
# CLIENT_BASE_URL=https://app.openplate.example

# ── Email (entirely optional) ──────────────────────────────────────────────
# Copy-link is the primary way to send an invite, and most self-hosters will
# never set any of this. It exists so an invite can be emailed instead.
#
# THERE ARE TWO WAYS TO SEND, AND YOU MAY CONFIGURE ONLY ONE. Either the SMTP
# block or the HTTP mail API block below — both together is refused at boot,
# because a gateway that quietly picked one would send through a transport you
# did not choose and could not see.
#
# Either way, GATEWAY_PUBLIC_URL and CLIENT_BASE_URL above become required — an
# invite email whose link points nowhere is worse than no email at all.

# ── Option 1: SMTP ─────────────────────────────────────────────────────────
# ALL FIVE OR NONE. A half-configured block is refused at boot: the alternative
# is a gateway that starts, accepts an invite request, fails inside a mail
# transport, and leaves you holding a spent invite and a stack trace.
#
# Port 465 is treated as implicit TLS; anything else as STARTTLS.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=gateway@example.com

# ── Option 2: an HTTP mail API ─────────────────────────────────────────────
# ALL THREE OR NONE, for the same reason as the SMTP block.
#
# Any Resend-compatible API works. MAIL_API_URL is the FULL SEND ENDPOINT, not
# a base address — Resend's is https://api.resend.com/emails, and a self-hosted
# one is typically http://your-mail-service:3601/v1/emails. Giving the whole URL
# is what keeps this gateway provider-agnostic: there is no provider name to
# configure and no list of supported providers to be absent from.
#
# The request is one POST with a bearer key. There is no retry: a failed send
# answers `emailed: false` and the invite link in the response still works.
#
# MAIL_API_URL=https://api.resend.com/emails
# MAIL_API_KEY=
# MAIL_API_FROM=gateway@example.com

# ── Organisation mode (OFF by default — read this before turning it on) ────
# UNSET OR false: this gateway is a FAMILY gateway. A request passes through it
# and is NEVER stored and NEVER logged. That is the default and it is absolute.
#
# true: this gateway STORES every submitted image in your own S3-compatible
# bucket and keeps an audit trail your admins can read, export and erase. It is
# for organisations — a clinic, a care home — that are accountable for what is
# submitted through them. See docs/org-mode.md and docs/adr/0003-*.md.
#
# TURNING IT ON RE-CONSENTS EVERYBODY. Members who joined in family mode are
# refused with `reconsent_required` and need a fresh invite: they never agreed to
# be audited. Requests made BEFORE the flip were never audited and cannot be
# reconstructed.
#
# Only `true` and `false` (and `1`/`0`) are accepted. `yes` is refused rather
# than guessed at — this flag must never be switched on by a value you meant as
# "off", or off by one you meant as "on".
# ORG_MODE=false

# EVERYTHING BELOW IS REQUIRED WHEN ORG_MODE=true, AND REFUSED WHEN IT IS NOT —
# except S3_FORCE_PATH_STYLE, AUDIT_MAX_BODY_BYTES and AUDIT_STORE_FILE, which
# are optional and carry defaults.
# A leftover S3_BUCKET on a family gateway fails at boot on purpose: an ignored
# bucket is an operator who believes images are being kept.
#
# Any S3-compatible store works and the endpoint is mandatory, because this mode
# exists for people who must keep the images on their own hardware. MinIO wants
# S3_FORCE_PATH_STYLE=true; AWS wants false.
# S3_ENDPOINT=http://minio:9000
# S3_REGION=eu-central-1
# S3_BUCKET=plate-audit
# S3_ACCESS_KEY_ID=gateway-audit
# S3_SECRET_ACCESS_KEY=replace-me
# S3_FORCE_PATH_STYLE=false

# How long records and their stored images are kept. REQUIRED — there is no
# default, because a retention period is your legal decision and not ours. A
# sweep runs at boot and daily and deletes everything older.
# AUDIT_RETENTION_DAYS=30

# Hard ceiling on ONE request body. Org mode buffers the body in order to audit
# it, so this is a memory bound as well as a policy: over it, the request is
# refused with 413 before anything is forwarded and before anything is stored.
# AUDIT_MAX_BODY_BYTES=20971520

# The audit records, one JSON object per line. MUST be on durable storage
# alongside the other stores — in Docker that is /app/state.
# AUDIT_STORE_FILE=./audit-log.jsonl

# ── Limits ─────────────────────────────────────────────────────────────────
# Largest request body accepted, in bytes. One plate photo fits comfortably;
# a bulk upload does not.
MAX_REQUEST_BYTES=8000000

# How long to wait for the upstream provider before giving up.
UPSTREAM_TIMEOUT_MS=120000

# Per-member burst limit, on top of the daily quota — stops one member burning
# a whole day's allowance in ten seconds.
RATE_LIMIT_PER_MINUTE=20

# ── HTTP ───────────────────────────────────────────────────────────────────
# Docker: docker/compose.yml hardcodes the host mapping `127.0.0.1:3602:3602`.
# Change this value and you must edit that mapping too, or the gateway listens
# on a port nothing is published to and is simply unreachable, with no error.
PORT=3602
LOG_LEVEL=info

# Origins allowed to call this gateway from a browser. `*` is the default
# because openplate is a browser app that may be served from anywhere,
# including a self-hoster's own domain. Narrow it if you know your origins.
CORS_ALLOWED_ORIGINS=*
