# openplate-gateway configuration.
#
# Every value below is a PLACEHOLDER. Nothing real belongs in this file — it is
# committed to a public repository.

# ── The upstream provider ──────────────────────────────────────────────────
# Where the gateway forwards requests. Any OpenAI-compatible endpoint works:
#   OpenRouter                https://openrouter.ai/api/v1
#   Mistral                   https://api.mistral.ai/v1
#   your own openplate-inference   http://inference:8300/v1
UPSTREAM_BASE_URL=https://openrouter.ai/api/v1

# The PAYER's real provider key. This is the one secret in the system, and it is
# the only place it exists — members never see it.
#
# Give this key a hard spend cap at the provider as well. The gateway's own
# per-member quotas are the first line of defence, not the last one.
UPSTREAM_API_KEY=replace-me

# ── State ──────────────────────────────────────────────────────────────────
# The members registry. Holds SHA-256 digests of member tokens, never the
# tokens. Generate entries with `pnpm mint-token`. Mount read-only.
MEMBERS_FILE=./members.json

# The daily quota counters. MUST be on durable storage: if this file is lost,
# every member gets a fresh allowance and the daily cap silently resets.
QUOTA_STORE_FILE=./quota-store.json

# ── Limits ─────────────────────────────────────────────────────────────────
# Largest request body accepted, in bytes. One plate photo fits comfortably;
# a bulk upload does not.
MAX_REQUEST_BYTES=8000000

# How long to wait for the upstream provider before giving up.
UPSTREAM_TIMEOUT_MS=120000

# Per-member burst limit, on top of the daily quota — stops one member burning
# a whole day's allowance in ten seconds.
RATE_LIMIT_PER_MINUTE=20

# ── HTTP ───────────────────────────────────────────────────────────────────
PORT=3602
LOG_LEVEL=info

# Origins allowed to call this gateway from a browser. `*` is the default
# because openplate is a browser app that may be served from anywhere,
# including a self-hoster's own domain. Narrow it if you know your origins.
CORS_ALLOWED_ORIGINS=*
